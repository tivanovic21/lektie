# Copy to .env and change if needed. Never commit .env.
# Read by docker compose and by the APIs (Spring imports this file when started from the IDE or bootRun).
DB_NAME=lektie
DB_USER=lektie
DB_PASSWORD=lektie
DB_PORT=5432

# ── Web API ────────────────────────────────────────────────────────────
# h2 = in-memory database with demo users (Admin/admin, Parent/parent, Teacher/teacher, Student/student)
# postgres = the docker compose database (schema from db/migrations)
WEB_API_PROFILE=h2
# Only with the postgres profile: insert the demo users if they are missing.
SEED_DEMO_USERS=false

# JWT signing keys (RS256), base64 body on ONE line, without the BEGIN/END lines.
# Empty is fine for the h2 profile (a throwaway pair is generated, logins reset on restart).
# Generate (Git Bash):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem
#   openssl pkey -in jwt_private.pem -pubout -out jwt_public.pem
#   grep -v -- ----- jwt_private.pem | tr -d '\r\n'   -> JWT_PRIVATE_KEY
#   grep -v -- ----- jwt_public.pem  | tr -d '\r\n'   -> JWT_PUBLIC_KEY
# then delete both .pem files.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=lektie-web-api
JWT_EXPIRATION=24h

# true in production (HTTPS). SameSite=None needs COOKIE_SECURE=true and CSRF protection.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# Lektie Studio origins allowed by CORS, comma separated.
FRONTEND=http://localhost:5173
